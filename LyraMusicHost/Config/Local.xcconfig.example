// Copy this file to Local.xcconfig (same folder) and set your own Team ID.
//
//     cp LyraMusicHost/Config/Local.xcconfig.example LyraMusicHost/Config/Local.xcconfig
//
// Local.xcconfig is gitignored, so your team ID never gets committed and never
// clobbers a collaborator's signing. Find your Team ID in Xcode → Settings →
// Accounts, or at https://developer.apple.com/account (Membership).

DEVELOPMENT_TEAM = YOUR_TEAM_ID_HERE

// OPTIONAL — only if you can't use the group.com.randll.lyra App Group (it belongs to
// the upstream Apple account). Uncomment to build without the App Group entitlement:
// the app signs under your wildcard profile and keeps com.randll.lyra's data, but the
// home-screen widgets won't receive shared data. Leave commented to keep widgets.
// LYRA_HOST_ENTITLEMENTS =
// LYRA_WIDGET_ENTITLEMENTS =
